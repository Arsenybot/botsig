# ==========================================
# SigmaSMS Gateway Configuration
# ==========================================
# DEFAULT_SIGMA_TOKEN: Default SigmaSMS API token (optional fallback)
DEFAULT_SIGMA_TOKEN="263eeb0e5bed8ba1a54ab3a9728bb7ce20f067d6364c294c81bc95acef4e4ee0"

# CHECK_INTERVAL_SECONDS: Background balance check interval in seconds (default: 60)
CHECK_INTERVAL_SECONDS="60"

# ==========================================
# Security & Storage Configuration
# ==========================================
# ENCRYPTION_MASTER_KEY: Optional 32+ character master key seed for AES-256-GCM vault.
# If omitted, an isolated key file (.master.key) is auto-generated inside DATA_DIR/.vault/
ENCRYPTION_MASTER_KEY="your-super-secret-master-key-at-least-32-characters"

# DATA_DIR: Directory where the user database and encrypted vault are stored.
# In Cloud.ru Container Apps, mount your Persistent Volume to /app/data
DATA_DIR="/app/data"

# ==========================================
# Admin Dashboard Authentication
# ==========================================
